{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "api",
	"main": "src/index.ts",
	"compatibility_date": "2025-12-25",
	"d1_databases": [
		{
			"binding": "db",
			"database_name": "moveto-v3-api-db",
			"database_id": "e1a7c4f9-ebc1-40dd-80c7-25dc9ae2163e",
			"remote": true
		}
	],
	"services": [
		{
			"binding": "hash",
			"service": "argon2id"
		}
	],
	"kv_namespaces": [
		{
			"binding": "session_kv",
			"id": "a82d05bdf9af40c2907426083adaa31c",
			"remote": true
		}
	],
	"observability": {
		"enabled": false,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": false,
			"persist": true,
			"head_sampling_rate": 1
		}
	}
	// "compatibility_flags": [
	//   "nodejs_compat"
